UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.G then
		toggledMode = not toggledMode
		if toggledMode then
			player.CameraMode = Enum.CameraMode.Classic
			player.CameraMinZoomDistance = 10
			player.CameraMaxZoomDistance = 400
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		else
			if not forceThirdPersonMobile then
				player.CameraMode = originalCameraMode
				player.CameraMinZoomDistance = originalCameraMinZoom
				player.CameraMaxZoomDistance = originalCameraMaxZoom
			end
			UserInputService.MouseBehavior = originalMouseBehavior
			UserInputService.MouseIconEnabled = originalMouseIconEnabled
		end
	end
end)

local originalCarDetected = false
local currentHits = 0
local currentBreaks = 0

--[================================================================]--
-- Main Processing Loop (0 Delay / Simultaneous Multi-Hit)
--[================================================================]--

task.spawn(function()
	while true do
		local character = player.Character
		if character then
			local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
			
			if forceThirdPersonMobile then
				player.CameraMode = Enum.CameraMode.Classic
				if player.CameraMinZoomDistance < 10 then player.CameraMinZoomDistance = 10 end
				if player.CameraMaxZoomDistance < 400 then player.CameraMaxZoomDistance = 400 end
			end
			
			if toggledMode and player.CameraMinZoomDistance < 10 then
				player.CameraMinZoomDistance = 10
			end
			
			if humanoidRootPart and showVisualizer then
				rangeRing.Transparency = 0.7
				rangeRing.CFrame = CFrame.new(humanoidRootPart.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90))
				rangeRing.Size = Vector3.new(0.2, ATTACK_RANGE * 2, ATTACK_RANGE * 2)
			else
				rangeRing.Transparency = 1
			end
			
			-- Vehicle Tracker Loop
			local vehiclesFolder = workspace:FindFirstChild("Vehicles")
			if vehiclesFolder then
				local targetVehicle = vehiclesFolder:FindFirstChild("Claptima")
				if not targetVehicle then
					local children = vehiclesFolder:GetChildren()
					if #children > 0 then targetVehicle = children[1] end
				end
				
				if targetVehicle then
					vehicleStatus.Text = "Target: " .. targetVehicle.Name
					local propFolder = targetVehicle:FindFirstChild("VehicleProperty")
					
					if not originalCarDetected then
						for propName, box in pairs(propertyBoxes) do
							local nativeVal = nil
							pcall(function()
								if propFolder then nativeVal = propFolder:GetAttribute(propName) or propFolder[propName] end
								if not nativeVal then nativeVal = targetVehicle:GetAttribute(propName) or targetVehicle[propName] end
							end)
							if nativeVal then
								originalVehicleProperties[propName] = nativeVal
								box.Text = tostring(nativeVal)
							end
						end
						originalCarDetected = true
					end
					
					for propName, box in pairs(propertyBoxes) do
						local appliedVal = nil
						if vehicleModActive then
							appliedVal = tonumber(box.Text)
						else
							appliedVal = originalVehicleProperties[propName]
							if not box.IsFocused and appliedVal then box.Text = tostring(appliedVal) end
						end
						
						if appliedVal then
							pcall(function()
								if propFolder then
									propFolder:SetAttribute(propName, appliedVal)
									propFolder[propName] = appliedVal
								end
								targetVehicle:SetAttribute(propName, appliedVal)
								targetVehicle[propName] = appliedVal
							end)
						end
					end
					
					if vehicleModActive then
						local targetGasVal = tonumber(gasTextBox.Text)
						if targetGasVal then
							local gasObj = targetVehicle:FindFirstChild("gasLevel")
							if gasObj then pcall(function() gasObj.Value = targetGasVal end) end
						end
					end
				else
					vehicleStatus.Text = "Target Vehicle: None found"
					originalCarDetected = false
				end
			else
				vehicleStatus.Text = "Target Vehicle: workspace.Vehicles missing!"
				originalCarDetected = false
			end
			
			-- Instant NPC Combat (0 Delay)
			currentHits = 0
			if isRunning and humanoidRootPart then
				local npcsFolder = workspace:FindFirstChild("NPCs")
				if npcsFolder then
					for _, npcModel in ipairs(npcsFolder:GetChildren()) do
						if npcModel:IsA("Model") then
							local humanoid = npcModel:FindFirstChildOfClass("Humanoid")
							local rootPart = npcModel:FindFirstChild("HumanoidRootPart") or npcModel:FindFirstChild("RootPart") or npcModel:FindFirstChild("Head")
							
							if humanoid and rootPart and humanoid.Health > 0 then
								local distance = (rootPart.Position - humanoidRootPart.Position).Magnitude
								if distance <= ATTACK_RANGE then
									currentHits = currentHits + 1
									pcall(function()
										if remoteEvent then
											remoteEvent:FireServer("Punches", "ReplicateSound", humanoidRootPart, "Swoosh")
											remoteEvent:FireServer("NPCs", "Damage", humanoid, DAMAGE_AMOUNT)
										end
									end)
								end
							end
						end
					end
				end
			end

			-- Instant Multi-Hit Auto Break (Hits ALL valid objects in range simultaneously with 0 delay)
			currentBreaks = 0
			if autoBreakRunning and humanoidRootPart then
				local mapFolder = workspace:FindFirstChild("Map")
				if mapFolder then
					local buildingsFolder = mapFolder:FindFirstChild("Buildings")
					if buildingsFolder then
						local validTargetNames = { ["ATM"] = true, ["CashRegister"] = true, ["Vault"] = true, ["Safe"] = true }
						
						for _, obj in ipairs(buildingsFolder:GetDescendants()) do
							if obj:IsA("Model") and validTargetNames[obj.Name] then
								local targetPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("RootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
								
								if targetPart then
									local health = 100
									local humanoid = obj:FindFirstChildOfClass("Humanoid")
									if humanoid then
										health = humanoid.Health
									else
										local healthVal = obj:FindFirstChild("Health") or obj:FindFirstChild("HP")
										if healthVal then
											pcall(function() health = healthVal.Value end)
										else
											local attrHealth = obj:GetAttribute("Health") or obj:GetAttribute("HP")
											if attrHealth then health = attrHealth end
										end
									end
									
									if health > 0 then
										local distance = (targetPart.Position - humanoidRootPart.Position).Magnitude
										if distance <= ATTACK_RANGE then
											currentBreaks = currentBreaks + 1
											pcall(function()
												if remoteEvent then
													remoteEvent:FireServer("DamageToOpen", "Damage", obj, 6, "melee")
												end
											end)
										end
									end
								end
							end
						end
					end
				end
			end

			targetLabel.Text = string.format("Hits: %d | Breaks: %d", currentHits, currentBreaks)
		end
		
		RunService.Heartbeat:Wait()
	end
end)

