dropSelectedBtn.MouseButton1Click:Connect(function()
	local backpack = player:FindFirstChild("Backpack")
	if backpack and remoteEvent then
		for itemName, isSelected in pairs(selectedLootItems) do
			if isSelected then
				local bpItem = backpack:FindFirstChild(itemName)
				if bpItem then
					pcall(function()
						remoteEvent:FireServer("Loot", "LootUnequip", bpItem, false)
					end)
				end
			end
		end
	end
end)

dropAllBtn.MouseButton1Click:Connect(function()
	local backpack = player:FindFirstChild("Backpack")
	if backpack and remoteEvent then
		for _, bpItem in ipairs(backpack:GetChildren()) do
			local itemName = bpItem.Name
			local isBackpack = string.find(itemName, "Backpack") ~= nil
			local isArmor = string.find(itemName, "Armor") ~= nil
			
			if not isBackpack and not isArmor then
				pcall(function()
					remoteEvent:FireServer("Loot", "LootUnequip", bpItem, false)
				end)
			end
		end
	end
end)

