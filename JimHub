local originalCarDetected = false
local currentHits = 0
local currentBreaks = 0

--[================================================================]--
-- Main Processing Loop
--[================================================================]--

RunService.Heartbeat:Connect(function(dt)
	local character = player.Character
	if character then
		local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		
		-- CFrame Speed Handler
		if humanoidRootPart and humanoid then
			if speedModActive then
				humanoid.WalkSpeed = 16 -- keep base normal to prevent native prediction glitches
				local moveDir = humanoid.MoveDirection
				if moveDir.Magnitude > 0 then
					humanoidRootPart.CFrame = humanoidRootPart.CFrame + (moveDir * customCFrameSpeed * dt)
				end
			end
			
			-- JumpPower Handler
			if customJumpPower then
				pcall(function()
					humanoid.JumpPower = customJumpPower
					humanoid.UseJumpPower = true
				end)
			end
		end
		
		-- Noclip Handler
		if noclipActive then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
		
		if forceThirdPersonMobile then
			player.CameraMode = Enum.CameraMode.Classic
			if player.CameraMinZoomDistance < 10 then player.CameraMinZoomDistance = 10 end
			if player.CameraMaxZoomDistance < 400 then player.CameraMaxZoomDistance = 400 end
		end
		
		if toggledMode and player.CameraMinZoomDistance < 10 then
			player.CameraMinZoomDistance = 10
		end
		
		if humanoidRootPart and showVisualizer then
			rangeRing.Transparency = 0.7
			rangeRing.CFrame = CFrame.new(humanoidRootPart.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90))
			rangeRing.Size = Vector3.new(0.2, ATTACK_RANGE * 2, ATTACK_RANGE * 2)
		else
			rangeRing.Transparency = 1
		end
		
		-- Auto Loot Dynamic Updating & Handling
		local lootFolder = workspace:FindFirstChild("Loot")
		local backpack = player:FindFirstChild("Backpack")
		local discoveredItems = {}
		
		if lootFolder then
			for _, lootItem in ipairs(lootFolder:GetChildren()) do
				discoveredItems[lootItem.Name] = true
			end
		end
		if backpack then
			for _, bpItem in ipairs(backpack:GetChildren()) do
				discoveredItems[bpItem.Name] = true
			end
		end
		
		local itemY = 0
		local existingGuiItems = {}
		for _, child in ipairs(lootScrollingFrame:GetChildren()) do
			if child:IsA("TextButton") then existingGuiItems[child.Name] = child end
		end
		
		for itemName, _ in pairs(discoveredItems) do
			if selectedLootItems[itemName] == nil then
				selectedLootItems[itemName] = false
			end
			
			local itemBtn = existingGuiItems[itemName]
			if not itemBtn then
				itemBtn = Instance.new("TextButton")
				itemBtn.Name = itemName
				itemBtn.Size = UDim2.new(1, -8, 0, 24)
				itemBtn.Font = Enum.Font.GothamMedium
				itemBtn.TextSize = 10
				itemBtn.Parent = lootScrollingFrame
				Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 4)
				
				itemBtn.MouseButton1Click:Connect(function()
					selectedLootItems[itemName] = not selectedLootItems[itemName]
				end)
			end
			
			if selectedLootItems[itemName] then
				itemBtn.BackgroundColor3 = Color3.fromRGB(35, 140, 35)
				itemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				itemBtn.Text = "✓ " .. itemName
			else
				itemBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
				itemBtn.TextColor3 = Color3.fromRGB(160, 160, 160)
				itemBtn.Text = "□ " .. itemName
			end
			
			itemBtn.Position = UDim2.new(0, 4, 0, itemY)
			itemY = itemY + 28
		end
		
		for name, btn in pairs(existingGuiItems) do
			if not discoveredItems[name] then
				btn:Destroy()
			end
		end
		lootScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, itemY + 5)
		
		if autoLootActive and lootFolder and remoteFunction then
			for _, lootItem in ipairs(lootFolder:GetChildren()) do
				local name = lootItem.Name
				local shouldLoot = false
				
				if lootAllMode then
					shouldLoot = true
				elseif selectedLootItems[name] then
					shouldLoot = true
				end
				
				if shouldLoot then
					local targetHandle = lootItem:FindFirstChild("Handle") or lootItem:FindFirstChildWhichIsA("BasePart")
					if targetHandle then
						pcall(function()
							remoteFunction:InvokeServer("Loot", "LootEquip", targetHandle)
						end)
					end
				end
			end
		end
		
		-- Vehicle Tracker Loop
		local vehiclesFolder = workspace:FindFirstChild("Vehicles")
		if vehiclesFolder then
			local targetVehicle = vehiclesFolder:FindFirstChild("Claptima")
			if not targetVehicle then
				local children = vehiclesFolder:GetChildren()
				if #children > 0 then targetVehicle = children[1] end
			end
			
			if targetVehicle then
				vehicleStatus.Text = "Target: " .. targetVehicle.Name
				local propFolder = targetVehicle:FindFirstChild("VehicleProperty")
				
				if not originalCarDetected then
					for propName, box in pairs(propertyBoxes) do
						local nativeVal = nil
						pcall(function()
							if propFolder then nativeVal = propFolder:GetAttribute(propName) or propFolder[propName] end
							if not nativeVal then nativeVal = targetVehicle:GetAttribute(propName) or targetVehicle[propName] end
						end)
						if nativeVal then
							originalVehicleProperties[propName] = nativeVal
							box.Text = tostring(nativeVal)
						end
					end
					originalCarDetected = true
				end
				
				for propName, box in pairs(propertyBoxes) do
					local appliedVal = nil
					if vehicleModActive then
						appliedVal = tonumber(box.Text)
					else
						appliedVal = originalVehicleProperties[propName]
						if not box.IsFocused and appliedVal then box.Text = tostring(appliedVal) end
					end
					
					if appliedVal then
						pcall(function()
							if propFolder then
								propFolder:SetAttribute(propName, appliedVal)
								propFolder[propName] = appliedVal
							end
							targetVehicle:SetAttribute(propName, appliedVal)
							targetVehicle[propName] = appliedVal
						end)
					end
				end
				
				if vehicleModActive then
					local targetGasVal = tonumber(gasTextBox.Text)
					if targetGasVal then
						local gasObj = targetVehicle:FindFirstChild("gasLevel")
						if gasObj then pcall(function() gasObj.Value = targetGasVal end) end
					end
				end
			else
				vehicleStatus.Text = "Target Vehicle: None found"
				originalCarDetected = false
			end
		else
			vehicleStatus.Text = "Target Vehicle: workspace.Vehicles missing!"
			originalCarDetected = false
		end
		
		-- Instant NPC Combat
		currentHits = 0
		if isRunning and humanoidRootPart then
			local npcsFolder = workspace:FindFirstChild("NPCs")
			if npcsFolder then
				for _, npcModel in ipairs(npcsFolder:GetChildren()) do
					if npcModel:IsA("Model") then
						local hum = npcModel:FindFirstChildOfClass("Humanoid")
						local rootPart = npcModel:FindFirstChild("HumanoidRootPart") or npcModel:FindFirstChild("RootPart") or npcModel:FindFirstChild("Head")
						
						if hum and rootPart and hum.Health > 0 then
							local distance = (rootPart.Position - humanoidRootPart.Position).Magnitude
							if distance <= ATTACK_RANGE then
								currentHits = currentHits + 1
								pcall(function()
									local ev = remoteEvent or ReplicatedStorage:FindFirstChild("Event")
									if ev then
										ev:FireServer("Punches", "ReplicateSound", humanoidRootPart, "Swoosh")
										ev:FireServer("NPCs", "Damage", hum, DAMAGE_AMOUNT)
									end
								end)
							end
						end
					end
				end
			end
		end

		-- Instant Multi-Hit Auto Break
		currentBreaks = 0
		if autoBreakRunning and humanoidRootPart then
			local mapFolder = workspace:FindFirstChild("Map")
			if mapFolder then
				local buildingsFolder = mapFolder:FindFirstChild("Buildings")
				if buildingsFolder then
					local validTargetNames = { ["ATM"] = true, ["CashRegister"] = true, ["Vault"] = true, ["Safe"] = true }
					
					for _, obj in ipairs(buildingsFolder:GetDescendants()) do
						if obj:IsA("Model") and validTargetNames[obj.Name] then
							local targetPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("RootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
							
							if targetPart then
								local health = 100
								local hum = obj:FindFirstChildOfClass("Humanoid")
								if hum then
									health = hum.Health
								else
									local healthVal = obj:FindFirstChild("Health") or obj:FindFirstChild("HP")
									if healthVal then
										pcall(function() health = healthVal.Value end)
									else
										local attrHealth = obj:GetAttribute("Health") or obj:GetAttribute("HP")
										if attrHealth then health = attrHealth end
									end
								end
								
								if health > 0 then
									local distance = (targetPart.Position - humanoidRootPart.Position).Magnitude
									if distance <= ATTACK_RANGE then
										currentBreaks = currentBreaks + 1
										pcall(function()
											local ev = remoteEvent or ReplicatedStorage:FindFirstChild("Event")
											if ev then
												ev:FireServer("DamageToOpen", "Damage", obj, 1000, "melee")
											end
										end)
									end
								end
							end
						end
					end
				end
			end
		end

		targetLabel.Text = string.format("Hits: %d | Breaks: %d", currentHits, currentBreaks)
	end
end)

