-- Safe Remote Function & Remote Event Retrieval
local remoteFunction = nil
local remoteEvent = nil

task.spawn(function()
	pcall(function()
		remoteFunction = ReplicatedStorage:WaitForChild("Function", 5)
		remoteEvent = ReplicatedStorage:WaitForChild("Event", 5)
	end)
	if not remoteFunction then
		for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
			if descendant:IsA("RemoteFunction") then
				remoteFunction = descendant
				break
			end
		end
	end
	if not remoteEvent then
		for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
			if descendant:IsA("RemoteEvent") then
				remoteEvent = descendant
				break
			end
		end
	end
end)

